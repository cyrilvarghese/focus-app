# Copy to .env.local and fill in. .env.local is git-ignored.
# Supabase: Project Settings → API (or the "Connect" button on the project home)
# Both values are safe in the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
